+<?xml version="1.0" encoding="UTF-8"?>
+<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="900" viewBox="0 0 1400 900" role="img" aria-labelledby="title desc">
+  <title id="title">Vector Ledger on AWS — as-built architecture</title>
+  <desc id="desc">Cognito-authenticated SPA, Lambda/API Gateway control plane, DynamoDB proposals, ECS convert/apply, S3 GeoParquet and PMTiles lake.</desc>
+  <defs>
+    <style>
+      .title { font: 700 28px Inter, Segoe UI, sans-serif; fill: #202124; }
+      .caption { font: 500 15px Inter, Segoe UI, sans-serif; fill: #5f6368; }
+      .box-title { font: 700 16px Inter, Segoe UI, sans-serif; fill: #202124; }
+      .box-body { font: 400 13px Inter, Segoe UI, sans-serif; fill: #3c4043; }
+      .lane { font: 700 12px Inter, Segoe UI, sans-serif; fill: #1A73E8; letter-spacing: 0.04em; }
+      .arrow { stroke: #5f6368; stroke-width: 2; fill: none; marker-end: url(#arrow); }
+      .future { font: 500 13px Inter, Segoe UI, sans-serif; fill: #5f6368; }
+    </style>
+    <marker id="arrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
+      <path d="M0,0 L10,4 L0,8 Z" fill="#5f6368"/>
+    </marker>
+  </defs>
+  <rect width="1400" height="900" fill="#F8F9FA"/>
+  <text x="700" y="48" text-anchor="middle" class="title">Vector Ledger on AWS — as built</text>
+  <text x="700" y="74" text-anchor="middle" class="caption">Cognito SPA · Lambda/API Gateway · DynamoDB proposals · ECS convert/apply · S3 GeoParquet + PMTiles</text>
+
+  <!-- 1 Clients -->
+  <rect x="40" y="110" width="280" height="160" rx="10" fill="#fff" stroke="#1A73E8" stroke-width="2"/>
+  <text x="56" y="138" class="lane">1 · CLIENTS</text>
+  <text x="56" y="168" class="box-title">Browser SPA</text>
+  <text x="56" y="190" class="box-body">app.vectorscopeai.com</text>
+  <text x="56" y="210" class="box-body">CloudFront + S3</text>
+  <text x="56" y="238" class="box-title">Public playground</text>
+  <text x="56" y="258" class="box-body">embed on vectorscopeai.com</text>
+
+  <!-- 2 Auth & edge -->
+  <rect x="360" y="110" width="300" height="160" rx="10" fill="#fff" stroke="#34A853" stroke-width="2"/>
+  <text x="376" y="138" class="lane">2 · AUTH &amp; EDGE</text>
+  <text x="376" y="168" class="box-title">Amazon Cognito</text>
+  <text x="376" y="188" class="box-body">Sign-up / sign-in / email confirm</text>
+  <text x="376" y="214" class="box-title">CloudFront + WAF</text>
+  <text x="376" y="234" class="box-body">SPA + public routes; rate limit</text>
+  <text x="376" y="258" class="box-body">SES sandbox invites</text>
+
+  <!-- 3 API -->
+  <rect x="700" y="110" width="320" height="160" rx="10" fill="#fff" stroke="#FBBC04" stroke-width="2"/>
+  <text x="716" y="138" class="lane">3 · API / CONTROL PLANE</text>
+  <text x="716" y="168" class="box-title">API Gateway HTTP → Lambda</text>
+  <text x="716" y="190" class="box-body">Sandboxes · members · invites · jobs</text>
+  <text x="716" y="210" class="box-body">Proposals · publish tokens · entitlements</text>
+  <text x="716" y="236" class="box-title">DynamoDB</text>
+  <text x="716" y="256" class="box-body">Changelog &amp; approvals; apply → new lake version</text>
