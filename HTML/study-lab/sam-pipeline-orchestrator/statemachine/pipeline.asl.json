{
  "Comment": "GSA Iceland pipeline — Night 32 Step Functions capstone",
  "StartAt": "RunIcelandTask",
  "States": {
    "RunIcelandTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${TaskDefinitionArn}",
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "${PrivateSubnetA}",
              "${PrivateSubnetB}"
            ],
            "SecurityGroups": [
              "${FargateSecurityGroupId}"
            ],
            "AssignPublicIp": "DISABLED"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "ECS.AmazonECSException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.ecs",
      "Next": "EnqueueCompletion"
    },
    "EnqueueCompletion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "${CompletionQueueUrl}",
        "MessageBody": {
          "source": "sam-pipeline-orchestrator",
          "resort_id": "IS-001",
          "resort_name": "Bláfjöll",
          "country_code": "IS",
          "taskArn.$": "$.ecs.Tasks[0].TaskArn",
          "stoppedReason.$": "$.ecs.Tasks[0].StoppedReason"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sqs",
      "Next": "InvokeStatsUploader"
    },
    "InvokeStatsUploader": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatsUploaderFunctionArn}",
        "Payload": {
          "resort_id": "IS-001",
          "resort_name": "Bláfjöll",
          "country_code": "IS",
          "taskArn.$": "$.ecs.Tasks[0].TaskArn",
          "source": "sam-pipeline-orchestrator"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureAlert",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.lambda",
      "Next": "PublishSuccess"
    },
    "PublishSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertsTopicArn}",
        "Subject": "GSA Iceland pipeline succeeded (Step Functions)",
        "Message.$": "States.Format('Iceland task {} completed; stats uploader invoked.', $.ecs.Tasks[0].TaskArn)"
      },
      "End": true
    },
    "PublishFailureAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertsTopicArn}",
        "Subject": "GSA Iceland pipeline failed (Step Functions)",
        "Message.$": "States.Format('Pipeline failure: {}', States.JsonToString($.error))"
      },
      "End": true
    }
  }
}
